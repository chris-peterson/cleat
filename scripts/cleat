#!/usr/bin/env python3
"""cleat — hold a repo's agent instructions in one AGENTS.md, with CLAUDE.md a pointer.

    cleat check [DIR] [--json]   report DIR's findings; exit 1 on any error finding
    cleat hook                   read a hook payload on stdin, decide, emit

python3 standard library only. This runs from a hook, where an import error is a
silent failure.

The division of labour: this script decides *facts* — which files exist, whether
the ref is present, whether two files duplicate each other. What counts as
tool-agnostic is a judgment call, so the deny reason carries the rubric in short
form and names guides/agents-vs-claude.md for the long one.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import re
import shutil
import sys
import time

AGENTS = "AGENTS.md"
CLAUDE = "CLAUDE.md"

# Topic rules belong here rather than in a foreign config: Claude Code loads a
# path-scoped rule only when it reads a matching file, and no import mechanism
# does that — an `@path` import loads at launch whatever it costs.
RULES_DIR = ".claude/rules"
# Every reader loads the index at launch, in every session. Past this it starts
# competing with the guidance it exists to point at.
TOC_MAX_BYTES = 2048
# Brace groups multiply, so one glob can stand for thousands of patterns, each a
# tree walk. Real rules need a handful: `{src,lib}/**/*.{ts,tsx,js,jsx}` is 8.
MAX_GLOB_PATTERNS = 64
# The findings whose repair is the rules index itself, so the nudge hands over
# the rendered rows with them.
INDEX_CODES = ("unlisted-rule", "dead-rule-listed", "toc-bloat")

# Single-tool instruction files. Whatever guidance they hold, the other tools
# ignore it. `.cursor/rules` is a directory of them.
FOREIGN_CONFIGS = (
    ".cursorrules",
    ".cursor/rules",
    ".github/copilot-instructions.md",
    ".windsurfrules",
    "GEMINI.md",
)

ERROR = "error"
ADVISORY = "advisory"

# `@AGENTS.md` is what makes Claude Code load the file; the markdown link above
# it is for humans. Accept the ./-prefixed spelling of either direction.
REF = re.compile(r"@\.?/?AGENTS\.md\b")
BACKREF = re.compile(r"@\.?/?CLAUDE\.md\b")
LINK_TO_AGENTS = re.compile(r"\]\(\.?/?AGENTS\.md\)")

# An AGENTS.md this short that mentions CLAUDE.md is a stub pointing back at it,
# not a document that happens to discuss the file.
STUB_MAX_LINES = 12
# Under this length a shared line is boilerplate — a link, a fence, a one-word
# bullet — rather than duplicated guidance.
DUP_MIN_CHARS = 40
# Session state outlives its session only long enough to be uninteresting.
SESSION_TTL_SECONDS = 7 * 24 * 60 * 60

RUBRIC = pathlib.Path(__file__).resolve().parent.parent / "guides" / "agents-vs-claude.md"

POINTER = """Agent instructions live in [AGENTS.md](./AGENTS.md).

@AGENTS.md
"""


# ---- findings ---------------------------------------------------------------

class Finding:
    __slots__ = ("code", "severity", "path", "message", "repair")

    def __init__(self, code, severity, path, message, repair):
        self.code = code
        self.severity = severity
        self.path = path
        self.message = message
        self.repair = repair

    def as_dict(self):
        return {
            "code": self.code,
            "severity": self.severity,
            "path": self.path,
            "message": self.message,
            "repair": self.repair,
        }


def _read(path):
    """Text of path, or "" when it isn't there. A file that exists but can't be
    read is a hard error — guessing at its content would produce a wrong verdict."""
    if not path.is_file():
        return ""
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        raise RuntimeError("cannot read {}: {}".format(path, exc))


def _substantive(text):
    return bool(text.strip())


def _pointer_only(text):
    """Whether text is the pointer shape with nothing below it: it carries the
    ref, and every line is either the ref or a link to AGENTS.md."""
    return bool(REF.search(text)) and all(
        REF.search(line) or LINK_TO_AGENTS.search(line)
        for line in text.splitlines() if line.strip())


def _norm(line):
    return " ".join(line.split()).lower()


def _classify(text):
    """(headings, body-lines) of text, normalized. Fenced blocks count as body —
    a copied command block is duplicated guidance — but a `#` comment inside one
    is not a heading."""
    headings = set()
    body = set()
    fenced = False
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("```"):
            fenced = not fenced
            continue
        norm = _norm(line)
        if not norm:
            continue
        if not fenced and stripped.startswith("#"):
            headings.add(_norm(stripped.lstrip("#")))
        elif len(norm) >= DUP_MIN_CHARS:
            body.add(norm)
    return headings, body


def _is_backpointer(agents_text):
    """Whether AGENTS.md points at CLAUDE.md rather than carrying the guidance."""
    if BACKREF.search(agents_text):
        return True
    lines = [line for line in agents_text.splitlines() if line.strip()]
    return len(lines) <= STUB_MAX_LINES and CLAUDE in agents_text


def _foreign_findings(root):
    out = []
    for rel in FOREIGN_CONFIGS:
        target = root / rel
        present = any(target.iterdir()) if target.is_dir() else target.is_file()
        if not present:
            continue
        out.append(Finding(
            "foreign-config", ERROR, rel,
            "{} holds guidance only one tool reads".format(rel),
            "consolidate it into {}; leave behind only what is genuinely "
            "tool-specific".format(AGENTS),
        ))
    return out


def _duplication_findings(claude_text, agents_text):
    claude_headings, claude_body = _classify(claude_text)
    agents_headings, agents_body = _classify(agents_text)

    shared_body = sorted(claude_body & agents_body)
    if shared_body:
        return [Finding(
            "duplicated", ERROR, CLAUDE,
            "{} line(s) of guidance appear in both files and will drift "
            "apart".format(len(shared_body)),
            "delete them from {}; {} is canonical".format(CLAUDE, AGENTS),
        )]

    shared_headings = sorted(claude_headings & agents_headings)
    if shared_headings:
        return [Finding(
            "duplicated", ADVISORY, CLAUDE,
            "both files carry the heading(s) {}".format(
                ", ".join(repr(h) for h in shared_headings)),
            "check whether the sections beneath them say the same thing; if so "
            "keep only {}'s".format(AGENTS),
        )]
    return []


# ---- topic rules ------------------------------------------------------------

def _rule_globs(text):
    """The rule's `paths:` globs, or None when it declares none — which is what
    makes a rule always-on."""
    if not text.startswith("---\n"):
        return None
    end = text.find("\n---", 4)
    if end < 0:
        return None
    globs = []
    in_paths = False
    for line in text[4:end].splitlines():
        inline = re.match(r"^paths:\s*\[(.*)\]\s*$", line)
        if inline:
            items = [p.strip().strip("\"'") for p in inline.group(1).split(",")]
            return [p for p in items if p] or None
        if re.match(r"^paths:\s*$", line):
            in_paths = True
            continue
        if in_paths:
            stripped = line.strip()
            if stripped.startswith("- "):
                globs.append(stripped[2:].strip().strip("\"'"))
            elif stripped:
                break
    return globs or None


def _expand_braces(pattern):
    """`**/*.{ts,tsx}` as the patterns it stands for, or None past
    MAX_GLOB_PATTERNS. Claude Code expands these itself, so a rule's reach is
    only readable after expansion. The cap is checked as the expansion grows,
    so an oversized glob costs no more than the cap to reject."""
    done, pending = [], [pattern]
    while pending:
        current = pending.pop(0)
        match = re.search(r"\{([^{}]*)\}", current)
        if not match:
            done.append(current)
            continue
        head, tail = current[:match.start()], current[match.end():]
        pending.extend(head + option + tail for option in match.group(1).split(","))
        if len(done) + len(pending) > MAX_GLOB_PATTERNS:
            return None
    return done


def _glob_segments(pattern):
    return [s for s in pattern.split("/") if s not in ("", ".")]


def _expanded(globs):
    """(patterns, None) for a rule's globs, or (None, (glob, reason, repair)) for
    the first one cleat cannot evaluate. Claude Code's `paths:` globs are
    repo-relative, and walking outside the repo would classify the rule by files
    it never sees."""
    patterns = []
    for pattern in globs:
        expanded = _expand_braces(pattern)
        if expanded is None:
            return None, (pattern,
                          "expands to more than {} patterns".format(MAX_GLOB_PATTERNS),
                          "split it into globs with fewer brace groups")
        for one in expanded:
            if one.startswith("/"):
                return None, (pattern, "is absolute",
                              "rewrite it relative to the repo root")
            if ".." in one.split("/"):
                return None, (pattern, "climbs out of the repo with `..`",
                              "rewrite it relative to the repo root")
        patterns.extend(expanded)
    return patterns, None


def _segment_regex(segment):
    """One glob path segment as a regex fragment. As in glob, a wildcard never
    matches a leading dot, so `*.md` skips `.hidden.md`."""
    out = [] if segment.startswith(".") else ["(?!\\.)"]
    i = 0
    while i < len(segment):
        c = segment[i]
        if c == "*":
            out.append("[^/]*")
        elif c == "?":
            out.append("[^/]")
        elif c == "[":
            j = i + 1
            if j < len(segment) and segment[j] == "!":
                j += 1
            if j < len(segment) and segment[j] == "]":
                j += 1
            end = segment.find("]", j)
            if end < 0:
                out.append(re.escape(c))
            else:
                body = segment[i + 1:end].replace("\\", "\\\\")
                if body.startswith("!"):
                    body = "^" + body[1:]
                elif body.startswith("^"):
                    body = "\\" + body
                out.append("(?!/)[" + body + "]")
                i = end
        else:
            out.append(re.escape(c))
        i += 1
    return "".join(out)


def _glob_regex(pattern):
    """The expanded glob as a regex over repo-relative posix file paths, with
    glob's recursive semantics: `**` spans zero or more directories, none of
    them dot-named."""
    segments = _glob_segments(pattern)
    parts = []
    for index, segment in enumerate(segments):
        last = index == len(segments) - 1
        if segment == "**":
            parts.append("(?:(?!\\.)[^/]+/)*" + ("(?!\\.)[^/]+" if last else ""))
        else:
            parts.append(_segment_regex(segment) + ("" if last else "/"))
    return re.compile("^" + "".join(parts) + "$")


def _walk_root(root, pattern):
    """The deepest directory the glob names literally, which bounds where a
    match can be."""
    prefix = []
    for segment in _glob_segments(pattern)[:-1]:
        if any(c in segment for c in "*?["):
            break
        prefix.append(segment)
    return root.joinpath(*prefix)


def _matches_any_file(root, patterns):
    """Whether any file here matches one of these expanded globs. A rule matching
    nothing cannot fire, so indexing it spends launch context on a rule that
    never loads. os.walk leaves directory symlinks unfollowed, which is what
    keeps a symlink cycle from making the walk endless."""
    by_top = {}
    for pattern in patterns:
        if not any(c in pattern for c in "*?["):
            if (root / pattern).is_file():
                return True
            continue
        by_top.setdefault(_walk_root(root, pattern), []).append(pattern)
    for top, group in by_top.items():
        regexes = [_glob_regex(p) for p in group]
        wants_hidden = any("/." in "/" + p for p in group)
        # Without `**` a glob reaches a fixed depth, and nothing below it can match.
        depth = None
        if not any("**" in _glob_segments(p) for p in group):
            prefix = len(top.relative_to(root).parts)
            depth = max(len(_glob_segments(p)) for p in group) - prefix - 1
        for dirpath, dirnames, filenames in os.walk(top):
            below = len(pathlib.Path(dirpath).relative_to(top).parts)
            dirnames[:] = [d for d in dirnames
                           if d != ".git" and (wants_hidden or not d.startswith("."))
                           and (depth is None or below < depth)]
            rel_dir = pathlib.Path(dirpath).relative_to(root).as_posix()
            for name in filenames:
                rel = name if rel_dir == "." else rel_dir + "/" + name
                if any(regex.match(rel) for regex in regexes):
                    return True
    return False


def _topic_rules(root):
    """(always-on, path-scoped, retired, unreadable) rules, relative to the rules
    dir. An unreadable rule is (rel, glob, reason, repair): a glob cleat cannot
    evaluate leaves the rule out of the other three."""
    base = root / RULES_DIR
    if not base.is_dir():
        return [], [], [], []
    always_on, path_scoped, retired, unreadable = [], [], [], []
    for path in sorted(base.rglob("*.md")):
        rel = path.relative_to(base).as_posix()
        globs = _rule_globs(_read(path))
        if globs is None:
            always_on.append(rel)
            continue
        patterns, problem = _expanded(globs)
        if problem:
            unreadable.append((rel,) + problem)
        elif _matches_any_file(root, patterns):
            path_scoped.append(rel)
        else:
            retired.append(rel)
    return always_on, path_scoped, retired, unreadable


def _names_rule(text, rel):
    """Whether AGENTS.md names this rule. The basename counts, so a row may name
    a nested rule without repeating its directory."""
    return rel in text or rel.rsplit("/", 1)[-1] in text


def _index_lines(agents_text, names):
    """The AGENTS.md lines naming a topic rule. Measuring the index this way
    imposes no heading convention on AGENTS.md."""
    return [line for line in agents_text.splitlines()
            if any(_names_rule(line, rel) for rel in names)]


def _index_size(lines):
    return sum(len(line.encode("utf-8")) + 1 for line in lines)


def _render_index(root, rules):
    """The index `AGENTS.md` should carry. The always-on rules get one line
    between them, because a tool that cannot scope reads all of them anyway; the
    path-scoped ones get the glob that decides when to read them, which is the
    one thing no reader can derive without opening every rule's frontmatter.
    Retired rules get nothing — a row for a rule that cannot fire is launch
    context spent on nothing."""
    always_on, path_scoped, _retired, _unreadable = rules
    lines = []
    if always_on:
        lines.append(
            "Every file in `{}/` without `paths:` frontmatter applies to all "
            "work here; read them.".format(RULES_DIR))
    if path_scoped:
        groups = {}
        for rel in path_scoped:
            globs = _rule_globs(_read(root / RULES_DIR / rel)) or []
            key = ", ".join("`{}`".format(g) for g in globs)
            groups.setdefault(key, []).append(rel)
        if lines:
            lines.append("")
        lines.append("These load only for matching files:")
        lines.append("")
        lines.append("| Applies to | Rule |")
        lines.append("| --- | --- |")
        for key in sorted(groups):
            lines.append("| {} | {} |".format(key, ", ".join(sorted(groups[key]))))
    return "\n".join(lines)


def _rendered_index(root, rules=None):
    """(the index `AGENTS.md` should carry, its launch cost), the cost measured
    the way toc-bloat measures `AGENTS.md`."""
    rules = rules or _topic_rules(root)
    text = _render_index(root, rules)
    names = rules[0] + rules[1] + rules[2]
    return text, _index_size(_index_lines(text, names))


def _rules_findings(root, agents_text):
    # `cleat check ~` would otherwise reach ~/.claude/rules, which is user-scope
    # memory with no AGENTS.md to be indexed from.
    if _under_user_claude(root / RULES_DIR):
        return []
    rules = _topic_rules(root)
    always_on, path_scoped, retired, unreadable = rules
    if not (always_on or path_scoped or retired or unreadable):
        return []

    out = []
    for rel, pattern, reason, repair in unreadable:
        out.append(Finding(
            "bad-glob", ERROR, "{}/{}".format(RULES_DIR, rel),
            "{}/{} has the glob {!r}, which {}, so cleat cannot tell whether "
            "the rule can fire".format(RULES_DIR, rel, pattern, reason),
            repair,
        ))

    for rel in path_scoped:
        if _names_rule(agents_text, rel):
            continue
        out.append(Finding(
            "unlisted-rule", ERROR, "{}/{}".format(RULES_DIR, rel),
            "{}/{} is path-scoped and no {} row names it, so every tool that "
            "cannot load {} is blind to it".format(
                RULES_DIR, rel, AGENTS, RULES_DIR),
            "add a row to {} naming {} and the globs it answers to".format(
                AGENTS, rel),
        ))

    for rel in retired:
        if not _names_rule(agents_text, rel):
            continue
        out.append(Finding(
            "dead-rule-listed", ERROR, "{}/{}".format(RULES_DIR, rel),
            "the index names {}, whose globs match no file here, so the row "
            "loads in every session for a rule that cannot fire".format(rel),
            "drop {}'s row from {}".format(rel, AGENTS),
        ))

    size = _index_size(_index_lines(agents_text, always_on + path_scoped + retired))
    named_always_on = [rel for rel in always_on if _names_rule(agents_text, rel)]
    if size > TOC_MAX_BYTES:
        _index, floor = _rendered_index(root, rules)
        if floor > TOC_MAX_BYTES:
            repair = (
                "consolidate the path-scoped rules into fewer glob sets; the "
                "smallest index these rules allow is {} bytes".format(floor))
        else:
            repair = (
                "index the path-scoped rules and their globs — the one thing a "
                "reader cannot derive without opening every rule's frontmatter")
        out.append(Finding(
            "toc-bloat", ADVISORY, AGENTS,
            "the index is {} bytes, loaded at launch by every tool in every "
            "session".format(size),
            repair,
        ))
    elif always_on and len(named_always_on) * 2 > len(always_on):
        out.append(Finding(
            "toc-bloat", ADVISORY, AGENTS,
            "the index enumerates {} of {} always-on rules".format(
                len(named_always_on), len(always_on)),
            "replace those rows with one line pointing at {}; a tool that "
            "cannot scope reads every always-on rule anyway".format(RULES_DIR),
        ))
    return out


def findings_for(root):
    """Every finding for a single directory, most structural first."""
    root = pathlib.Path(root)
    claude_text = _read(root / CLAUDE)
    agents_text = _read(root / AGENTS)
    # A file that exists but is blank loads nothing, so presence is measured by
    # content rather than by the directory entry.
    has_claude = _substantive(claude_text)
    has_agents = _substantive(agents_text)

    out = []
    if not has_claude and not has_agents:
        out.append(Finding(
            "unguided", ADVISORY, str(root),
            "neither {} nor {} — no agent starts here with project "
            "context".format(AGENTS, CLAUDE),
            "write {}, then a {} holding the link and the @{} ref".format(
                AGENTS, CLAUDE, AGENTS),
        ))
    elif has_claude and not has_agents and _pointer_only(claude_text):
        out.append(Finding(
            "dangling-ref", ERROR, CLAUDE,
            "{} imports {}, which does not exist, so no tool gets any "
            "guidance".format(CLAUDE, AGENTS),
            "write {} with the repo's tool-agnostic guidance; {} is already "
            "the pointer".format(AGENTS, CLAUDE),
        ))
    elif has_claude and not has_agents:
        out.append(Finding(
            "no-agents", ERROR, CLAUDE,
            "the guidance is in {} with no {} — every tool but Claude Code "
            "gets nothing".format(CLAUDE, AGENTS),
            "move the tool-agnostic body to {} and leave {} as the "
            "pointer".format(AGENTS, CLAUDE),
        ))
    elif has_agents and not has_claude:
        out.append(Finding(
            "no-claude", ADVISORY, AGENTS,
            "{} exists with no {} — Claude Code reads {} by default, but not on "
            "a third-party provider, with telemetry off, or in the first "
            "session after an upgrade".format(AGENTS, CLAUDE, AGENTS),
            "add a {} carrying the link and @{} on its own line, so every "
            "session loads it the same way".format(CLAUDE, AGENTS),
        ))

    inverted = has_agents and _is_backpointer(agents_text)
    if inverted:
        out.append(Finding(
            "inverted", ERROR, AGENTS,
            "{} is a stub pointing back at {}, so every non-Claude tool gets "
            "the stub".format(AGENTS, CLAUDE),
            "swap them: the body belongs in {}, and {} becomes the "
            "pointer".format(AGENTS, CLAUDE),
        ))

    # An inversion always lacks the ref too; its repair covers both, so reporting
    # no-ref alongside it would just be the same fix said twice.
    if has_claude and has_agents and not inverted and not REF.search(claude_text):
        out.append(Finding(
            "no-ref", ERROR, CLAUDE,
            "{} carries no @{} ref, so Claude Code loads none of "
            "{}".format(CLAUDE, AGENTS, AGENTS),
            "add @{} on its own line; a markdown link alone does not import "
            "it".format(AGENTS),
        ))

    if has_claude and has_agents:
        out.extend(_duplication_findings(claude_text, agents_text))
    # With no AGENTS.md there is nothing to index from, and the pointer repair
    # above comes first, so rules findings would only restate it once per rule.
    if has_agents:
        out.extend(_rules_findings(root, agents_text))
    out.extend(_foreign_findings(root))
    return out


def has_errors(findings):
    return any(f.severity == ERROR for f in findings)


def render(findings):
    if not findings:
        return ""
    # Wide enough that the longest code still has a gap after it.
    width = max(len(f.code) for f in findings) + 2
    lines = []
    for f in findings:
        suffix = " (advisory)" if f.severity == ADVISORY else ""
        lines.append("{}{}{}".format(f.code.ljust(width), f.message, suffix))
        lines.append("{}-> {}".format(" " * width, f.repair))
    return "\n".join(lines)


# ---- session state ----------------------------------------------------------
#
# The gate's re-issue record, the nudge's last-reported finding set, and the
# bootstrap triggers already fired are all per-session, so they live under one
# session directory and vanish with it.

def _state_root():
    env = os.environ.get("CLAUDE_PLUGIN_DATA")
    if env:
        return pathlib.Path(env)
    # The same canonical path computed the other way: Claude Code names a
    # plugin's data dir <plugin>-<owner>.
    return pathlib.Path.home() / ".claude" / "plugins" / "data" / "cleat-chris-peterson"


def _key(*parts):
    digest = hashlib.sha256()
    for part in parts:
        digest.update(str(part).encode("utf-8"))
        digest.update(b"\0")
    return digest.hexdigest()


def _prune_sessions(sessions):
    cutoff = time.time() - SESSION_TTL_SECONDS
    try:
        stale = [d for d in sessions.iterdir() if d.is_dir() and d.stat().st_mtime < cutoff]
    except OSError:
        return
    for d in stale:
        shutil.rmtree(d, ignore_errors=True)


def _session_dir(session_id, bucket):
    sessions = _state_root() / "sessions"
    session = sessions / (_key(session_id)[:32] if session_id else "unknown")
    if not session.exists() and sessions.is_dir():
        _prune_sessions(sessions)
    target = session / bucket
    target.mkdir(parents=True, exist_ok=True)
    return target


def _claim(session_id, bucket, name):
    """True when this marker was already set — consuming it."""
    marker = _session_dir(session_id, bucket) / name
    if marker.exists():
        marker.unlink()
        return True
    return False


def _mark(session_id, bucket, name, body=""):
    (_session_dir(session_id, bucket) / name).write_text(body, encoding="utf-8")


def _marked(session_id, bucket, name):
    marker = _session_dir(session_id, bucket) / name
    return marker.read_text(encoding="utf-8") if marker.is_file() else None


def _unmark(session_id, bucket, name):
    marker = _session_dir(session_id, bucket) / name
    if marker.exists():
        marker.unlink()


# ---- hook: shared -----------------------------------------------------------

def _resolved(path):
    try:
        return pathlib.Path(path).resolve()
    except OSError:
        return pathlib.Path(path)


def _under_user_claude(path):
    """User-scope memory under ~/.claude is Claude-specific by nature."""
    base = _resolved(pathlib.Path.home() / ".claude")
    target = _resolved(path)
    return target == base or base in target.parents


def _rules_owner(path):
    """The directory whose `.claude/rules/` holds this path, or None. A rule's
    own parent is the wrong place to check from: the index it belongs to lives
    beside the rules directory, not inside it."""
    resolved = _resolved(path)
    parts = RULES_DIR.split("/")
    for candidate in resolved.parents:
        if candidate.joinpath(*parts) in resolved.parents:
            return candidate
    return None


def _repo_root(directory):
    """The enclosing git work tree, resolved, or None. Used to tell a repo's root
    README from one sitting in a subdirectory."""
    resolved = _resolved(directory)
    for candidate in [resolved] + list(resolved.parents):
        if (candidate / ".git").exists():
            return candidate
    return None


def _written_content(tool, path, tool_input):
    """The content the tool is about to leave on disk, or None when it can't be
    determined from the payload."""
    if tool == "Write":
        content = tool_input.get("content")
        return content if isinstance(content, str) else None
    if tool == "Edit":
        old = tool_input.get("old_string")
        new = tool_input.get("new_string")
        if not isinstance(old, str) or not isinstance(new, str):
            return None
        current = _read(path)
        if not current:
            return None
        count = -1 if tool_input.get("replace_all") else 1
        return current.replace(old, new, count)
    return None


# ---- hook: the write gate ---------------------------------------------------

DENY_REASON = """cleat: this directory has no {agents}, so a {claude} carrying the guidance would \
reach Claude Code and nothing else. Around 30 other agent tools read {agents} and \
never look at {claude}.

Re-issue this as two writes:

  1. {agents_path} — the tool-agnostic body: what the project does, its build and \
test commands, layout, conventions, glossary, architecture constraints.
  2. {claude_path} — the pointer, with any genuinely Claude-specific remainder \
below it:

{pointer}

The rubric, short form: if Cursor or Codex would act correctly on the line, it \
belongs in {agents}. Only slash commands, hooks, settings.json, plugins, and \
subagent definitions stay in {claude}. When it is ambiguous, choose {agents} — a \
Claude-only line there is read and ignored by the other tools, but a shared line \
kept in {claude} is invisible to all of them and nothing reports the absence.

Full rubric: {rubric}

If this {claude} genuinely is all Claude-specific, re-issue the identical write \
and it will be allowed through."""


def _deny_reason(path):
    indented = "\n".join("      " + line if line else line
                         for line in POINTER.rstrip().splitlines())
    return DENY_REASON.format(
        agents=AGENTS, claude=CLAUDE,
        agents_path=path.parent / AGENTS, claude_path=path,
        pointer=indented, rubric=RUBRIC,
    )


def pre_tool_use(payload):
    tool = payload.get("tool_name")
    if tool not in ("Write", "Edit"):
        return None
    tool_input = payload.get("tool_input") or {}
    raw_path = tool_input.get("file_path")
    if not raw_path:
        return None

    path = pathlib.Path(raw_path)
    # CLAUDE.local.md falls out here too: per-user, un-committed memory is
    # Claude-specific by nature, so the gate has no opinion about it.
    if path.name != CLAUDE:
        return None
    if _under_user_claude(path):
        return None
    if _substantive(_read(path.parent / AGENTS)):
        return None

    content = _written_content(tool, path, tool_input)
    if content is None:
        return None
    # An empty file, or one already declaring AGENTS.md canonical, is the shape
    # this gate is trying to produce. A ref with no AGENTS.md yet is the nudge's.
    if not _substantive(content) or REF.search(content):
        return None

    session_id = payload.get("session_id") or ""
    digest = _key(session_id, path, content)
    if _claim(session_id, "denied", digest):
        return None
    _mark(session_id, "denied", digest)
    return {"hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny",
        "permissionDecisionReason": _deny_reason(path),
    }}


# ---- hook: the repair nudge -------------------------------------------------

def _nudge(session_id, directory):
    name = _key(_resolved(directory))
    findings = findings_for(directory)
    if not findings:
        # Clean now, so a later regression is worth reporting again.
        _unmark(session_id, "nudged", name)
        return None

    digest = _key(*("{}:{}:{}".format(f.code, f.severity, f.path) for f in findings))
    if _marked(session_id, "nudged", name) == digest:
        return None
    _mark(session_id, "nudged", name, digest)

    body = (
        "cleat — {} still has an agent-instruction shape worth fixing:\n\n{}\n\n"
        "{} is canonical: when the two files disagree or overlap, the body stays "
        "in {} and {} keeps only the ref plus genuinely Claude-specific "
        "guidance.".format(directory, render(findings), AGENTS, AGENTS, CLAUDE)
    )
    # Composing the index by hand is where it drifts from the directory, so an
    # index finding hands over the rows rather than describing them. Rows over
    # budget would not clear toc-bloat, so they are not worth the context.
    if any(f.code in INDEX_CODES for f in findings):
        index, cost = _rendered_index(pathlib.Path(directory))
        if index and cost <= TOC_MAX_BYTES:
            body += (
                "\n\nThe index {} should carry, derived from the rules "
                "themselves — replace the rows that name rules with it, and "
                "leave the rest of the file alone:\n\n{}".format(AGENTS, index))
    return {"hookSpecificOutput": {
        "hookEventName": "PostToolUse",
        "additionalContext": body,
    }}


# ---- hook: bootstrap guidance -----------------------------------------------

def _foreign_relative(path):
    """The FOREIGN_CONFIGS entry path corresponds to, or None."""
    resolved = _resolved(path)
    parts = resolved.parts
    for rel in FOREIGN_CONFIGS:
        tail = pathlib.PurePath(rel).parts
        if rel == ".cursor/rules":
            if tail[0] in parts and tail[1] in parts:
                return rel
        elif parts and parts[-1] == tail[-1]:
            return rel
    return None


def _bootstrap(session_id, path):
    directory = path.parent
    if _under_user_claude(path):
        return None

    if path.name == AGENTS:
        claude_text = _read(directory / CLAUDE)
        # With no CLAUDE.md, Claude Code reads AGENTS.md at startup by default;
        # the check's no-claude advisory covers the sessions that skip it.
        if not _substantive(claude_text) or REF.search(claude_text):
            return None
        trigger = "agents-unlinked"
        summary = (
            "{0} was just read by hand. {1} here carries no @{0} ref, and Claude "
            "Code skips a directly read {0} wherever a {1} exists, so this "
            "guidance never reaches a session at startup.".format(AGENTS, CLAUDE)
        )
        action = (
            "Offer to add @{} on its own line in {}, so the guidance loads at "
            "startup instead of on demand.".format(AGENTS, CLAUDE)
        )
    elif path.name in ("README.md", "CONTRIBUTING.md"):
        if _repo_root(directory) != _resolved(directory):
            return None
        if _substantive(_read(directory / AGENTS)) or _substantive(_read(directory / CLAUDE)):
            return None
        trigger = "unguided"
        summary = (
            "This repo has neither {} nor {}, so no agent starts here with any "
            "project context.".format(AGENTS, CLAUDE)
        )
        action = (
            "Offer to write {} from what this repo shows — what it does, its "
            "build and test commands, its conventions — plus a {} pointer that "
            "imports it.".format(AGENTS, CLAUDE)
        )
    else:
        rel = _foreign_relative(path)
        if rel is None:
            return None
        trigger = "foreign:{}".format(rel)
        summary = "{} holds guidance only one tool reads.".format(rel)
        action = (
            "Offer to consolidate it into {}, which about 30 tools read, leaving "
            "behind only what is genuinely tool-specific.".format(AGENTS)
        )

    name = _key(_resolved(directory), trigger)
    if _marked(session_id, "booted", name) is not None:
        return None
    _mark(session_id, "booted", name)

    return {
        "systemMessage": "cleat: {}".format(summary),
        "hookSpecificOutput": {
            "hookEventName": "PostToolUse",
            "additionalContext": "cleat — {}\n\n{}\n\nRubric: {}".format(
                summary, action, RUBRIC),
        },
    }


def post_tool_use(payload):
    tool = payload.get("tool_name")
    tool_input = payload.get("tool_input") or {}
    raw_path = tool_input.get("file_path")
    if not raw_path:
        return None
    path = pathlib.Path(raw_path)
    session_id = payload.get("session_id") or ""

    if tool in ("Write", "Edit"):
        if _under_user_claude(path):
            return None
        if path.name in (AGENTS, CLAUDE):
            return _nudge(session_id, path.parent)
        # A new topic rule is unindexed by construction, so the write that
        # creates it is the moment the index can still be fixed in the same turn.
        owner = _rules_owner(path)
        if owner is not None:
            return _nudge(session_id, owner)
        return None
    if tool == "Read":
        return _bootstrap(session_id, path)
    return None


# ---- commands ---------------------------------------------------------------

def cmd_check(args):
    directory = pathlib.Path(args.directory)
    if not directory.is_dir():
        sys.stderr.write("cleat: not a directory: {}\n".format(directory))
        return 2
    try:
        findings = findings_for(directory)
    except RuntimeError as exc:
        sys.stderr.write("cleat: {}\n".format(exc))
        return 2
    if args.json:
        json.dump({"directory": str(directory),
                   "findings": [f.as_dict() for f in findings]},
                  sys.stdout, indent=2)
        sys.stdout.write("\n")
    elif findings:
        print(render(findings))
    return 1 if has_errors(findings) else 0


def cmd_index(args):
    directory = pathlib.Path(args.directory)
    if not directory.is_dir():
        sys.stderr.write("cleat: not a directory: {}\n".format(directory))
        return 2
    try:
        index, _cost = _rendered_index(directory)
    except RuntimeError as exc:
        sys.stderr.write("cleat: {}\n".format(exc))
        return 2
    if index:
        print(index)
    return 0


def cmd_hook(_args):
    """Always exits 0. A hook's exit code is a channel Claude Code reads for
    something else, so a failure here is reported as a systemMessage the user
    sees rather than as a status."""
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw)
    except ValueError as exc:
        _emit({"systemMessage": "cleat: unparseable hook payload: {}".format(exc)})
        return 0

    event = payload.get("hook_event_name")
    try:
        if event == "PreToolUse":
            out = pre_tool_use(payload)
        elif event == "PostToolUse":
            out = post_tool_use(payload)
        else:
            out = None
    except Exception as exc:  # noqa: BLE001 — surfaced below, never swallowed
        out = {"systemMessage": "cleat: {} hook failed: {}: {}".format(
            event, exc.__class__.__name__, exc)}

    if out:
        _emit(out)
    return 0


def _emit(payload):
    json.dump(payload, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")


def main(argv=None):
    parser = argparse.ArgumentParser(prog="cleat", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)

    check = sub.add_parser("check", help="report a directory's findings")
    check.add_argument("directory", nargs="?", default=".")
    check.add_argument("--json", action="store_true", help="emit findings as JSON")
    check.set_defaults(func=cmd_check)

    index = sub.add_parser(
        "index", help="print the rules index AGENTS.md should carry")
    index.add_argument("directory", nargs="?", default=".")
    index.set_defaults(func=cmd_index)

    hook = sub.add_parser("hook", help="read a hook payload on stdin and decide")
    hook.set_defaults(func=cmd_hook)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
